{
  "name": "get-it-jacob",
  "productName": "Get It Jacob",
  "version": "1.0.3",
  "description": "Votre PDF, votre page, votre conversation.",
  "author": {
    "name": "beltromatti",
    "email": "beltromatti@gmail.com"
  },
  "homepage": "https://github.com/jhgfdsq/get-it-jacob",
  "license": "Apache-2.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate-pdfs": "tsx scripts/generate-sample-pdfs.ts",
    "test:errors": "tsx scripts/test-error-handling.ts",
    "test:md": "tsx scripts/test-md-import.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke-all": "node scripts/full-test.mjs",
    "build-writeup": "node scripts/build-pdf.mjs",
    "cleanup": "node scripts/cleanup-orphans.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "electron:prepare": "node scripts/electron-prepare.mjs",
    "build:desktop": "npm run build && npm run electron:prepare && node scripts/build-electron.mjs",
    "build:desktop:mac-arm": "npm run build && npm run electron:prepare -- --target=darwin-arm64 && node scripts/build-electron.mjs --target=mac-arm64",
    "browser:dev": "next dev --hostname 127.0.0.1",
    "test:reader": "tsx scripts/test-chat.ts && tsx scripts/test-preparation.ts && tsx scripts/test-pdf-inspection.ts && tsx scripts/test-manual-visual.ts",
    "test:long-pdf": "tsx scripts/test-long-pdf.ts",
    "test:captures": "tsx scripts/test-captures.ts && tsx scripts/test-chat-drafts.ts && tsx scripts/test-capture-geometry.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "katex": "^0.16.45",
    "lucide-react": "^1.14.0",
    "marked": "^14.1.4",
    "next": "16.2.6",
    "pdfjs-dist": "^5.7.284",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.170",
    "@earendil-works/pi-coding-agent": "^0.79.1",
    "@google/gemini-cli": "^0.45.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "fr.jacob.getit",
    "productName": "Get It Jacob",
    "copyright": "Copyright © 2026 beltromatti",
    "directories": {
      "buildResources": "electron/assets",
      "output": "dist-electron"
    },
    "afterSign": "scripts/electron-after-sign.cjs",
    "afterPack": "scripts/electron-after-pack.cjs",
    "npmRebuild": false,
    "asar": false,
    "files": [
      "electron/**/*",
      ".next/standalone/**",
      ".next/static/**",
      "public/**",
      "package.json",
      "!**/.DS_Store",
      "!**/*.map",
      "!**/*.ts",
      "!**/tsconfig*",
      "!node_modules/**/.bin",
      "LICENSE",
      "NOTICE"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": "dmg",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "electron/assets/entitlements.mac.plist",
      "entitlementsInherit": "electron/assets/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDisplayName": "Get It Jacob",
        "NSCameraUsageDescription": "Get It. does not access the camera; this entry is required by Apple's notarization rules because Electron's helper has the AVFoundation surface compiled in.",
        "NSMicrophoneUsageDescription": "Get It. does not access the microphone; this entry is required by Apple's notarization rules because Electron's helper has the AVFoundation surface compiled in.",
        "NSDocumentsFolderUsageDescription": "Get It. may read PDFs you explicitly pick from your Documents folder.",
        "NSDownloadsFolderUsageDescription": "Get It. may read PDFs you explicitly pick from your Downloads folder."
      }
    },
    "win": {
      "target": "nsis",
      "publisherName": "beltromatti"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "getItJacobNotice": "Modified September 2026 for Get It Jacob; see NOTICE for the fork changes."
}
